<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Handball.Belgium.RefTestManagement.Infrastructure</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ClosedXML" />
        <PackageReference Include="HotChocolate.Abstractions" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="QuestPDF" />
        <PackageReference Include="StrawberryShake.Server" />
    </ItemGroup>

    <ItemGroup>
        <!-- Data Protection for privacy challenge keys and participant credentials. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
            Include="..\RefTestManagement.Application\RefTestManagement.Application.csproj" />
        <ProjectReference Include="..\RefTestManagement.AuditLog\RefTestManagement.AuditLog.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Application ports, moved out of Infrastructure.Services, without a using in every consumer. -->
        <Using Include="Handball.Belgium.RefTestManagement.Application.Abstractions" />
    </ItemGroup>
</Project>