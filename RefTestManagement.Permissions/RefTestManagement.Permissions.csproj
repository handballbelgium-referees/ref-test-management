<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Handball.Belgium.RefTestManagement.Permissions</RootNamespace>

        <!-- NuGet packaging — ready to publish as a standalone package -->
        <PackageId>Handball.Belgium.RefTestManagement.Permissions</PackageId>
        <Version>1.0.0</Version>
        <Authors>Handball Belgium</Authors>
        <Description>
            Permission constants, role definitions, and claims helpers for the
            Handball Belgium RefTest Management platform.
        </Description>
        <PackageTags>permissions;reftestmanagement;handball</PackageTags>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>