<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Handball.Belgium.RefTestManagement.Worker</RootNamespace>
        <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
        <ContainerImageFormat>OCI</ContainerImageFormat>
        <ContainerRepository>ref-test-management-worker</ContainerRepository>
        <ContainerUser>app</ContainerUser>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <ContainerEnvironmentVariable Include="ASPNETCORE_HTTP_PORTS" Value="" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RefTestManagement.Hosting\RefTestManagement.Hosting.csproj" />
        <ProjectReference Include="..\RefTestManagement.Hosting.Azure\RefTestManagement.Hosting.Azure.csproj" />
    </ItemGroup>
</Project>
