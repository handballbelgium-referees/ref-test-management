{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "view|read|edit|create|str_replace_editor|apply_patch|bash|powershell|create_pull_request|update_pull_request",
        "bash": "node .ai/hooks/guards.mjs pre --provider=copilot",
        "powershell": "node .ai/hooks/guards.mjs pre --provider=copilot",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "edit|apply_patch|str_replace_editor|bash|powershell",
        "bash": "node .ai/hooks/guards.mjs post --provider=copilot",
        "powershell": "node .ai/hooks/guards.mjs post --provider=copilot",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
