{
  "name": "ref-test-management.ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "codegen": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 graphql-codegen"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@12.2.3",
  "dependencies": {
    "@angular/common": "~22.3.0",
    "@angular/compiler": "~22.3.0",
    "@angular/core": "~22.3.0",
    "@angular/forms": "~22.3.0",
    "@angular/platform-browser": "~22.3.0",
    "@angular/router": "~22.3.0",
    "@angular/service-worker": "~22.3.0",
    "@apollo/client": "~4.3.8",
    "@fortawesome/angular-fontawesome": "~5.1.0",
    "@fortawesome/fontawesome-svg-core": "~7.3.1",
    "@fortawesome/free-brands-svg-icons": "~7.3.1",
    "@fortawesome/free-solid-svg-icons": "~7.3.1",
    "@ngx-translate/core": "~18.1.0",
    "@ngx-translate/http-loader": "~18.1.0",
    "apollo-angular": "~14.2.0",
    "graphql": "~17.1.0",
    "graphql-sse": "~2.6.4",
    "rxjs": "~7.8.2",
    "tslib": "~2.9.1"
  },
  "devDependencies": {
    "@angular/build": "~22.3.0",
    "@angular/cli": "~22.3.0",
    "@angular/compiler-cli": "~22.3.0",
    "@graphql-codegen/cli": "~8.0.0",
    "@graphql-codegen/typescript-apollo-angular": "~6.0.0",
    "@graphql-codegen/typescript-operations": "~7.0.3",
    "@tailwindcss/postcss": "~4.3.5",
    "cross-env": "~10.1.0",
    "jsdom": "~31.0.1",
    "postcss": "~8.5.33",
    "sharp": "~0.35.5",
    "tailwindcss": "~4.3.5",
    "typescript": "~6.0.3",
    "vitest": "~5.1.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
