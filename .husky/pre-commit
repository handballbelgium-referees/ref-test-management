#!/usr/bin/env sh

# Skip hooks during CI or when message contains [skip ci]
if [ -n "$CI" ] || git log -1 --pretty=%B | grep -q "\[skip ci\]"; then
  exit 0
fi

# Keep README version tables in sync with Directory.Packages.props / package.json
node scripts/sync-readme-versions.mjs
git add README.md

cd RefTestManagement.Ui
npm run build